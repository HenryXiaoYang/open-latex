# LF everywhere, also in Windows checkouts (fixtures, golden files and byte offsets in tests
# assume it; CRLF sources are tested explicitly)
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.pdf binary

# Language statistics: fixtures, benchmarks and the TeX/Lua support files are not counted, so
# GitHub reports the project by its Rust code
fixtures/** linguist-vendored
bench/** linguist-vendored
tex/** linguist-vendored
