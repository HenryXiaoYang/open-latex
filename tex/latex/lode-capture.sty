%% lode-capture.sty — record paragraph contexts, line placements and page display lists
%% during a normal LuaLaTeX run. Adds no nodes; output is unchanged (verified by tests).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lode-capture}[2026/10/07 v0.1 lode layout capture]
\RequirePackage{luatexbase}
\directlua{
  lode_capture = dofile(kpse.find_file("lode-capture.lua", "lua") or "lode-capture.lua")
  lode_capture.setup{ jobname = tex.jobname }
}
\AddToHook{para/begin}{\directlua{lode_capture.parbegin()}}
\AddToHook{shipout/before}{\directlua{lode_capture.shipout(\number\ShipoutBox)}}
\AddToHook{enddocument/afterlastpage}{\directlua{lode_capture.finish()}}
% Map image resource indices to files so IMAGE display-list items can name their source.
\AddToHook{package/graphicx/after}{%
  \AddToHook{cmd/Gin@setfile/after}{%
    \directlua{lode_capture.image(\number\lastsavedimageresourceindex,
      "\luaescapestring{\Gin@base\Gin@ext}", "\luaescapestring{\Gin@page}",
      \number\lastsavedimageresourcepages)}}}
\endinput
